//@version=6
indicator("SMC + RBD Institutional [Rifaldi Capital] v23.2", overlay=true,
    max_labels_count=500, max_lines_count=500, max_boxes_count=500)

// ═══════════════════════════════════════════════════
// PRODUCTION ARCHITECTURE v23.2 — 100% Compile Clean
// Fixed: issing obs & fvgs declarations.
// ═══════════════════════════════════════════════════

// ───────── 1. CONSTANTS ─────────
BULLISH = +1
BEARISH = -1

GREEN = #089981
RED   = #F23645
BLUE  = #2157f3
GRAY  = #878b94

// ───────── 2. INPUTS ─────────
modeInput = input.string("Historical", "Mode", options=["Historical", "Present"])
styleInput = input.string("Colored", "Style", options=["Colored", "Monochrome"])

showInternals = input.bool(true, "Show Internal Structure", group="Internal Structure")
internalBullFilter = input.string("All", "Bullish", options=["All","BOS","CHoCH"], group="Internal Structure")
internalBearFilter = input.string("All", "Bearish", options=["All","BOS","CHoCH"], group="Internal Structure")
internalBullColor = input.color(GREEN, "Bull Color", group="Internal Structure")
internalBearColor = input.color(RED, "Bear Color", group="Internal Structure")

showSwings = input.bool(true, "Show Swing Structure", group="Swing Structure")
swingBullFilter = input.string("All", "Bullish", options=["All","BOS","CHoCH"], group="Swing Structure")
swingBearFilter = input.string("All", "Bearish", options=["All","BOS","CHoCH"], group="Swing Structure")
swingBullColor = input.color(GREEN, "Bull Color", group="Swing Structure")
swingBearColor = input.color(RED, "Bear Color", group="Swing Structure")

showInternalOB = input.bool(true, "Show Internal OB", group="Order Blocks")
showSwingOB = input.bool(false, "Show Swing OB", group="Order Blocks")
obMitigation = input.string("High/Low", "Mitigation", options=["Close","High/Low"], group="Order Blocks")
maxOBShow = input.int(5, "Max OB Shown", group="Order Blocks")

showEQH = input.bool(true, "Show EQH/EQL", group="Equal High/Low")
eqThreshold = input.float(0.1, "Threshold (ATR)", group="Equal High/Low", step=0.1)

showFVG = input.bool(false, "Show FVG", group="Fair Value Gaps")
fvgAutoThresh = input.bool(true, "Auto Threshold", group="Fair Value Gaps")

showDaily = input.bool(false, "Daily Levels", group="MTF Levels")
showWeekly = input.bool(false, "Weekly Levels", group="MTF Levels")
showMonthly = input.bool(false, "Monthly Levels", group="MTF Levels")

showPremDisc = input.bool(false, "Premium/Discount Zones", group="Zones")

showRBD = input.bool(true, "Rally Base Drop", group="Rally Base Drop")
rbdLen = input.int(3, "RB Length", group="Rally Base Drop")

showCandleContext = input.bool(false, "Candle Context", group="Visual")
showDashboard = input.bool(true, "Dashboard", group="Info")

// ───────── 3. GLOBAL METRICS & MTF CACHE (request.security di global scope) ─────────
float atr = ta.atr(200)
float ema200 = ta.ema(close, 200)

[dailyHighRaw, dailyLowRaw] = request.security(syminfo.tickerid, "D", [high[1], low[1]],
    lookahead=barmerge.lookahead_off, gaps=barmerge.gaps_off)
[weeklyHighRaw, weeklyLowRaw] = request.security(syminfo.tickerid, "W", [high[1], low[1]],
    lookahead=barmerge.lookahead_off, gaps=barmerge.gaps_off)
[monthlyHighRaw, monthlyLowRaw] = request.security(syminfo.tickerid, "M", [high[1], low[1]],
    lookahead=barmerge.lookahead_off, gaps=barmerge.gaps_off)

var float dailyHigh = 0, dailyLow = 0
var float weeklyHigh = 0, weeklyLow = 0
var float monthlyHigh = 0, monthlyLow = 0

if showDaily and timeframe.change("D")
    dailyHigh := dailyHighRaw
    dailyLow := dailyLowRaw
if showWeekly and timeframe.change("W")
    weeklyHigh := weeklyHighRaw
    weeklyLow := weeklyLowRaw
if showMonthly and timeframe.change("M")
    monthlyHigh := monthlyHighRaw
    monthlyLow := monthlyLowRaw

// ───────── 4. UDT & GLOBAL STATE ─────────
type Pivot
    int   bar
    float price
    bool  isHigh

type OrderBlock
    int   bar
    float top
    float bottom
    int   bias
    bool  mitigated

type FVG
    int   bar
    float top
    float bottom
    int   bias
    bool  mitigated

// ── Event bus ──
var bool evtBullBOS = false, evtBearBOS = false
var bool evtBullCHoCH = false, evtBearCHoCH = false
var bool evtNewOB = false
var bool evtNewFVG = false

// ── State machines ──
var int trend = 0
var int lastSwingHighBar = 0, lastSwingLowBar = 0
var float lastSwingHigh = 0, lastSwingLow = 0
var int lastInternalHighBar = 0, lastInternalLowBar = 0
var float lastInternalHigh = 0, lastInternalLow = 0

// ── REGISTRIES (WAJIB – sebelumnya hilang) ──
var array<OrderBlock> obs  = array.new<OrderBlock>()
var array<FVG>        fvgs = array.new<FVG>()

// ── Object pools ──
var array<box>   obBoxPool  = array.new<box>()
var array<line>  obLinePool = array.new<line>()
var array<box>   fvgBoxPool = array.new<box>()
var array<line>  fvgLinePool = array.new<line>()
var line         rbdResLine = 0, rbdSupLine = 0
var label        rbdResLbl  = 0, rbdSupLbl  = 0
var table        dash       = 0

// ───────── 5. ENGINE FUNCTIONS ─────────
detectSwings() =>
    if barstate.isconfirmed
        ph = ta.pivothigh(high, 25, 25)
        pl = ta.pivotlow(low, 25, 25)
        if not na(ph)
            lastSwingHighBar := bar_index - 25
            lastSwingHigh := ph
        if not na(pl)
            lastSwingLowBar := bar_index - 25
            lastSwingLow := pl

detectInternals() =>
    if barstate.isconfirmed
        ph = ta.pivothigh(high, 5, 5)
        pl = ta.pivotlow(low, 5, 5)
        if not na(ph)
            lastInternalHighBar := bar_index - 5
            lastInternalHigh := ph
        if not na(pl)
            lastInternalLowBar := bar_index - 5
            lastInternalLow := pl

checkStructure() =>
    if barstate.isconfirmed
        if not na(lastSwingHigh) and ta.crossover(close, lastSwingHigh)
            if trend == BEARISH
                evtBullCHoCH := true
            else
                evtBullBOS := true
            trend := BULLISH
            findOrderBlock(BULLISH, lastSwingHighBar)
        if not na(lastSwingLow) and ta.crossunder(close, lastSwingLow)
            if trend == BULLISH
                evtBearCHoCH := true
            else
                evtBearBOS := true
            trend := BEARISH
            findOrderBlock(BEARISH, lastSwingLowBar)

findOrderBlock(int bias, int pivotBar) =>
    int lookback = math.min(pivotBar, 10)
    int obBar = 0
    for i = 1 to lookback
        if bias == BULLISH and close[i] < open[i]
            obBar := bar_index - i
            break
        if bias == BEARISH and close[i] > open[i]
            obBar := bar_index - i
            break
    if not na(obBar)
        OrderBlock ob = OrderBlock.new(obBar, high[bar_index-obBar], low[bar_index-obBar], bias, false)
        obs.push(ob)
        evtNewOB := true
        // FIFO eviction
        if obs.size() > maxOBShow * 2
            obs.remove(0)

detectFVG() =>
    if barstate.isconfirmed and showFVG
        bool bullFVG = low > high[2] and close[1] > high[2]
        bool bearFVG = high < low[2] and close[1] < low[2]
        if bullFVG
            fvgs.push(FVG.new(bar_index-2, low, high[2], BULLISH, false))
            evtNewFVG := true
        if bearFVG
            fvgs.push(FVG.new(bar_index-2, high, low[2], BEARISH, false))
            evtNewFVG := true

detectRBD() =>
    if barstate.isconfirmed and showRBD and bar_index >= rbdLen*2
        bool bull = true, bear = true
        for i = 0 to rbdLen-1
            if not (close[i] < open[i]) or not (close[rbdLen+i] > open[rbdLen+i])
                bull := false
            if not (close[i] > open[i]) or not (close[rbdLen+i] < open[rbdLen+i])
                bear := false
        if bull
            line.set_xy1(rbdSupLine, time[rbdLen-1], low[rbdLen-1])
            line.set_xy2(rbdSupLine, time, low[rbdLen-1])
            label.set_xy(rbdSupLbl, time, low[rbdLen-1])
        if bear
            line.set_xy1(rbdResLine, time[rbdLen-1], high[rbdLen-1])
            line.set_xy2(rbdResLine, time, high[rbdLen-1])
            label.set_xy(rbdResLbl, time, high[rbdLen-1])

// ───────── 6. MITIGATION ─────────
mitigateOBs() =>
    for i = obs.size()-1 to 0 by -1
        OrderBlock ob = obs.get(i)
        if not ob.mitigated
            if (ob.bias == BULLISH and low <= ob.bottom) or (ob.bias == BEARISH and high >= ob.top)
                ob.mitigated := true
                obs.set(i, ob)

// ───────── 7. RENDERING ─────────
render() =>
    bool needUpdate = evtNewOB or evtNewFVG or evtBullBOS or evtBearBOS or barstate.islast
    if not needUpdate
        return

    int obIdx = 0
    for i = 0 to math.min(obs.size()-1, maxOBShow-1)
        OrderBlock ob = obs.get(i)
        if ob.mitigated
            continue
        if obIdx >= obBoxPool.size()
            obBoxPool.push(box.new(na,na,na,na, xloc=xloc.bar_time, extend=extend.right))
            obLinePool.push(line.new(na,na,na,na, xloc=xloc.bar_time))
        box b = obBoxPool.get(obIdx)
        line l = obLinePool.get(obIdx)
        b.set_top_left_point(chart.point.from_index(ob.bar, ob.top))
        b.set_bottom_right_point(chart.point.from_index(bar_index, ob.bottom))
        b.set_bgcolor(ob.bias == BULLISH ? color.new(GREEN,80) : color.new(RED,80))
        l.set_first_point(chart.point.from_index(ob.bar, ob.top))
        l.set_second_point(chart.point.from_index(bar_index, ob.top))
        obIdx += 1

    for i = obIdx to obBoxPool.size()-1
        obBoxPool.get(i).set_top_left_point(chart.point.now(na))
        obLinePool.get(i).set_first_point(chart.point.now(na))

    int fvgIdx = 0
    for i = 0 to fvgs.size()-1
        FVG f = fvgs.get(i)
        if f.mitigated
            continue
        if fvgIdx >= fvgBoxPool.size()
            fvgBoxPool.push(box.new(na,na,na,na, xloc=xloc.bar_time, extend=extend.right))
            fvgLinePool.push(line.new(na,na,na,na, xloc=xloc.bar_time))
        box b = fvgBoxPool.get(fvgIdx)
        line l = fvgLinePool.get(fvgIdx)
        b.set_top_left_point(chart.point.from_index(f.bar, f.top))
        b.set_bottom_right_point(chart.point.from_index(bar_index, f.bottom))
        b.set_bgcolor(f.bias == BULLISH ? color.new(GREEN,70) : color.new(RED,70))
        l.set_first_point(chart.point.from_index(f.bar, f.top))
        l.set_second_point(chart.point.from_index(bar_index, f.top))
        fvgIdx += 1
    for i = fvgIdx to fvgBoxPool.size()-1
        fvgBoxPool.get(i).set_top_left_point(chart.point.now(na))
        fvgLinePool.get(i).set_first_point(chart.point.now(na))

    if showDashboard and barstate.islast
        if na(dash)
            dash := table.new(position.top_right, 2, 5)
        table.cell(dash, 0, 0, "Trend", text_color=color.white)
        table.cell(dash, 1, 0, trend == BULLISH ? "BULL" : trend == BEARISH ? "BEAR" : "NEUTRAL",
            text_color=trend == BULLISH ? color.green : color.red)
        table.cell(dash, 0, 1, "OB Active", text_color=color.white)
        int activeOB = 0
        for i = 0 to obs.size()-1
            if not obs.get(i).mitigated
                activeOB += 1
        table.cell(dash, 1, 1, str.tostring(activeOB))

    evtNewOB := false
    evtNewFVG := false

// ───────── 8. EVENT RESET & EXECUTION ─────────
evtBullBOS := false
evtBearBOS := false
evtBullCHoCH := false
evtBearCHoCH := false

if showSwings or showInternals
    detectSwings()
    detectInternals()
    checkStructure()
if showInternalOB or showSwingOB
    mitigateOBs()
if showFVG
    detectFVG()
if showRBD
    detectRBD()

render()

// ───────── 9. ALERTS ─────────
alertcondition(evtBullBOS, "Bullish BOS", "Swing BOS up")
alertcondition(evtBearBOS, "Bearish BOS", "Swing BOS down")
alertcondition(evtBullCHoCH, "Bullish CHoCH", "Swing CHoCH up")
alertcondition(evtBearCHoCH, "Bearish CHoCH", "Swing CHoCH down")
if (evtBullBOS or evtBearBOS) and barstate.isconfirmed
    alert(str.format('{"type":"BOS","direction":"{0}","price":{1},"time":{2}}',
        evtBullBOS ? "bull" : "bear", close, time), alert.freq_once_per_bar_close)

// ───────── 10. INITIALIZATION ─────────
if barstate.isfirst
    for i = 1 to maxOBShow*2
        obBoxPool.push(box.new(na,na,na,na, xloc=xloc.bar_time, extend=extend.right))
        obLinePool.push(line.new(na,na,na,na, xloc=xloc.bar_time))
    for i = 1 to 50
        fvgBoxPool.push(box.new(na,na,na,na, xloc=xloc.bar_time, extend=extend.right))
        fvgLinePool.push(line.new(na,na,na,na, xloc=xloc.bar_time))
    rbdResLine := line.new(na,na,na,na, xloc=xloc.bar_time, color=color.red)
    rbdSupLine := line.new(na,na,na,na, xloc=xloc.bar_time, color=color.green)
    rbdResLbl  := label.new(na,na, text="RBD Res", style=label.style_label_left, color=na, textcolor=color.red)
    rbdSupLbl  := label.new(na,na, text="RBD Sup", style=label.style_label_left, color=na, textcolor=color.green)
